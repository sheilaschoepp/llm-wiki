{
    // Model pin: every session in this project runs Opus 5 with the 1M-token
    // context window, regardless of what the session or a user-level settings
    // file would otherwise select. Pinned to the explicit version, not the
    // "opus[1m]" alias — the alias resolves to whatever the installed CLI maps
    // it to, which currently lands a generation back. Bump this by hand when a
    // newer Opus ships; the consistency audit flags it once one exists.
    "model": "claude-opus-5[1m]",
    "env": {
        // Effort level: "max" buys the deepest reasoning per turn. On Opus 4.5+
        // the API keeps previous thinking blocks and re-bills them as input each
        // turn, so this is a context cost that grows over a session, not a flat one.
        "CLAUDE_CODE_EFFORT_LEVEL": "max"
    },
    "permissions": {
        // ── ALLOW: run without prompting ──────────────────────────────
        "allow": [
            // Everyday git operations that don't destroy history or local state.
            "Bash(git commit:*)",
            "Bash(git pull:*)",
            "Bash(git push:*)",
            // pip, in both the direct and module forms so the invocation
            // style can't decide whether the rule applies. Unrestricted by
            // environment: rules match the command text, not the running
            // shell, and a bare `pip install x` reads identically whether it
            // lands in a venv or in system Python.
            "Bash(pip install:*)",
            "Bash(pip uninstall:*)",
            "Bash(pip3 install:*)",
            "Bash(pip3 uninstall:*)",
            "Bash(python -m pip install:*)",
            "Bash(python -m pip uninstall:*)",
            "Bash(python3 -m pip install:*)",
            "Bash(python3 -m pip uninstall:*)",
            // conda, only in the forms that name their target environment
            // (-n <env> / -p <prefix>). Shell state does not survive between
            // tool calls, so a bare `conda activate` never reaches the
            // install — an install that lands in an environment has to name
            // it inline. Bare `conda install x` therefore prompts.
            "Bash(conda install -n:*)",
            "Bash(conda install -p:*)",
            "Bash(conda update -n:*)",
            "Bash(conda update -p:*)"
        ],
        // ── DENY: always blocked ──────────────────────────────────────
        // Scope: commands with no undo, plus anything run as root. Reversible
        // commands are otherwise left off this list on purpose — unlisted
        // commands still prompt, so nothing runs unapproved either way, and
        // deny is reserved for what must not be waved through by reflex.
        // Reinstalling a package is recoverable; a deleted file or a
        // rewritten history is not.
        //
        // sudo is the deliberate exception to "irreversible only": root turns
        // a recoverable mistake into an unrecoverable one, so the whole prefix
        // is blocked rather than the individual subcommands. Cost, accepted
        // knowingly — `sudo apt install`, `sudo systemctl`, and `sudo chmod`
        // are blocked too, with no in-session override, since a deny rule
        // can't be approved at the prompt, only edited out of this file.
        //
        // The root, file-deletion, and git rules apply on both the Mac and the
        // Linux server. Package-manager coverage is deliberately Mac-only:
        // brew is listed, apt is not, so `apt remove` on the Linux server
        // prompts rather than being blocked outright.
        //
        // Ordered most severe first, by how much unrecoverable work the
        // command destroys. The order is for reading only — a deny match is a
        // deny match wherever it sits, so nothing here depends on position.
        // settings.json is the file Claude Code actually reads and holds the
        // same rules in a different order; this copy mirrors that rule set,
        // not its line order.
        "deny": [
            // ── 1. Root: unbounded, and reaches outside the repo ──
            // Anything as root. Subsumes the sudo forms of the apt and rm
            // rules below, and catches variants a per-subcommand rule misses
            // (`sudo -u root apt purge`, `sudo apt -y remove`) — matching is
            // by prefix, so any flag ahead of the subcommand defeats a
            // narrower rule. Not airtight: `bash -c "sudo ..."`, or a script
            // that calls sudo internally, is opaque to string matching.
            "Bash(sudo:*)",
            // ── 2. Permanent file deletion: no undo anywhere ──
            "Bash(rm:*)",
            // ── 3. Destroys uncommitted work: git holds no copy of it ──
            "Bash(git clean -f:*)", // untracked files — never in git at all
            "Bash(git reset --hard:*)", // whole tree, and moves HEAD
            "Bash(git checkout --force:*)", // whole tree, on switching refs
            "Bash(git checkout -f:*)", // same, short form
            "Bash(git checkout .:*)", // current dir only, so narrower
            "Bash(git restore .:*)", // modern equivalent of the above
            // ── 4. Overwrites the remote: the two-machine hazard ──
            // Working on both the Mac and the Linux server means the remote
            // can hold commits this machine has never fetched. Force-pushing
            // over them destroys the only copy — a local reflog can't help
            // with work that was never local.
            "Bash(git push --force:*)",
            "Bash(git push -f:*)", // same, short form
            "Bash(git push --force-with-lease:*)", // mildest: refuses if the remote moved
            // ── 5. Destroys stashes: recoverable only via git fsck ──
            "Bash(git stash clear:*)", // ALL stashes
            "Bash(git stash drop:*)", // one stash
            // ── 6. Deletes local refs: the commits survive in the reflog ──
            "Bash(git branch -D:*)", // force-delete, orphaning unmerged commits
            "Bash(git tag -d:*)",
            "Bash(git tag --delete:*)", // same, long form
            // ── 7. System packages: reinstallable, so lower ──
            // Homebrew, the Mac package manager. Both the mutating installs
            // and the removal are listed, since an upgrade can pull a working
            // toolchain out from under a running project just as an uninstall
            // can. The sudo forms fall under the blanket rule above.
            "Bash(brew install:*)",
            "Bash(brew reinstall:*)",
            "Bash(brew upgrade:*)",
            "Bash(brew uninstall:*)",
            // ── 8. Environment mutation: rebuildable ──
            // Counterpart to the conda -n allow rule above: base is not a
            // project environment. Deny beats allow, so these win.
            "Bash(conda install -n base:*)",
            "Bash(conda update -n base:*)",
            // ── 9. Recoverable deletion: listed to keep the family whole ──
            "Bash(trash:*)", // macOS Trash — restorable
            "Bash(rmdir:*)" // empty directories only, so nothing is lost
        ]
    },
    // ── HOOKS: fire a macOS desktop notification (terminal-notifier)
    //    at moments where Claude is waiting on you, so you don't have
    //    to watch the terminal. Clicking a notification jumps to VS Code.
    //    macOS-only; on Linux terminal-notifier is absent and the hook
    //    simply does nothing.
    "hooks": {
        // Before certain tools run:
        "PreToolUse": [
            {
                // Claude is about to ask you a question.
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH terminal-notifier -message \"Claude has a question\" -title \"Claude Code\" -subtitle \"${PWD##*/}\" -activate com.microsoft.VSCode -contentImage \"/Applications/Visual Studio Code.app/Contents/Resources/Code.icns\""
                    }
                ]
            },
            {
                // Claude finished planning and wants sign-off before executing.
                "matcher": "ExitPlanMode",
                "hooks": [
                    {
                        "type": "command",
                        "command": "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH terminal-notifier -message \"Plan ready for review\" -title \"Claude Code\" -subtitle \"${PWD##*/}\" -activate com.microsoft.VSCode -contentImage \"/Applications/Visual Studio Code.app/Contents/Resources/Code.icns\""
                    }
                ]
            }
        ],
        // Claude needs a permission granted (empty matcher = any notification).
        "Notification": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH terminal-notifier -message \"Permission required\" -title \"Claude Code\" -subtitle \"${PWD##*/}\" -activate com.microsoft.VSCode -contentImage \"/Applications/Visual Studio Code.app/Contents/Resources/Code.icns\""
                    }
                ]
            }
        ],
        // Claude finished the task (empty matcher = any stop event).
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH terminal-notifier -message \"Task completed\" -title \"Claude Code\" -subtitle \"${PWD##*/}\" -activate com.microsoft.VSCode -contentImage \"/Applications/Visual Studio Code.app/Contents/Resources/Code.icns\""
                    }
                ]
            }
        ]
    }
}
